# 当前生产 URL，切换域名时修改此文件并重新构建
VITE_SITE_URL=https://kaoyan-reality-radar-web.vercel.app

# 站点部署在子路径时使用，例如 GitHub Pages 项目页：/kaoyan-reality-radar-web/
VITE_BASE_PATH=/

# 静态镜像跨域调用 Vercel API 时设置；同源 Vercel 主站保持空值
VITE_ENTITLEMENT_API_BASE=

# Vercel KV REST 配置，仅服务端和本地管码脚本使用，不要暴露到 VITE_* 变量
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 允许调用服务端 API 的来源，逗号分隔
ALLOWED_ORIGINS=https://kaoyan-reality-radar-web.vercel.app,https://august1314.github.io
